# Copy to .env only if you deploy to a public testnet. Local demos need none of this.
# Use a brand-new throwaway wallet. Never put a mnemonic that holds real funds in a file.
# Wallet index 0 (Petahour admin) and index 4 (Petahour Labs admin) must each hold testnet ETH.
PETAHOUR_MNEMONIC=
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
